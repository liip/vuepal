{
  "name": "vuepal",
  "version": "3.0.0-alpha.1",
  "description": "Nuxt+Vue Drupal Integration",
  "license": "MIT",
  "homepage": "https://github.com/liip/vuepal",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./adapter": "./dist/adapter.mjs"
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "adapter": [
        "./dist/adapter.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "npm run dev:prepare && npm run styles:build && nuxt-module-build build && find dist/ -type f -name '*.*' | grep '.spec.' | xargs rm -f",
    "dev": "nuxi dev playground --host",
    "typecheck": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "styles:build": "postcss ./css/index.css -o ./src/runtime/css/output.css",
    "styles:watch": "postcss ./css/index.css -o ./src/runtime/css/output.css --watch",
    "dev:build": "nuxi build playground",
    "dev:prepare": "PLAYGROUND_MODULE_BUILD=true nuxt-module-build build --stub && PLAYGROUND_MODULE_BUILD=true nuxt-module-build prepare && nuxi prepare playground",
    "dev:start": "node playground/.output/server/index.mjs",
    "release": "npm run lint && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "fzf": "^0.5.2",
    "yaml": "^2.4.1"
  },
  "devDependencies": {
    "@nuxt/devtools": "^1.4.2",
    "@nuxt/eslint": "^1.3.0",
    "@nuxt/kit": "^3.16.2",
    "@nuxt/module-builder": "^1.0.1",
    "@nuxt/schema": "^3.16.2",
    "@types/node": "latest",
    "@vue/test-utils": "^2.4.4",
    "changelogen": "^0.5.5",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "happy-dom": "^13.3.8",
    "nuxt": "^3.16.2",
    "nuxt-graphql-middleware": "^5.0.0-alpha.17",
    "nuxt-language-negotiation": "^1.0.1",
    "postcss": "^8.4.35",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.0.1",
    "postcss-mixins": "^9.0.4",
    "postcss-nested-import": "^1.3.0",
    "postcss-replace": "^2.0.1",
    "postcss-url": "^10.1.3",
    "tailwindcss": "^3.4.1",
    "vue-tsc": "^2.2.8"
  }
}
