{
  "name": "vuepal",
  "version": "3.0.5",
  "description": "Nuxt+Vue Drupal Integration",
  "license": "MIT",
  "homepage": "https://github.com/liip/vuepal",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./adapter": "./dist/adapter.mjs"
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "adapter": [
        "./dist/adapter.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "npm run dev:prepare && npm run styles:build && nuxt-module-build build && find dist/ -type f -name '*.*' | grep '.spec.' | xargs rm -f",
    "dev": "nuxi dev playground --host",
    "typecheck": "npm run typecheck:build && npm run typecheck:runtime && npm run typecheck:server && npm run typecheck:playground",
    "typecheck:build": "vue-tsc --noEmit -p .nuxt/tsconfig.node.json",
    "typecheck:runtime": "vue-tsc --noEmit -p .nuxt/tsconfig.app.json",
    "typecheck:server": "vue-tsc --noEmit -p .nuxt/tsconfig.server.json",
    "typecheck:playground": "vue-tsc --noEmit -p ./playground/.nuxt/tsconfig.app.json",
    "styles:build": "postcss ./css/index.css -o ./src/runtime/css/output.css",
    "styles:watch": "postcss ./css/index.css -o ./src/runtime/css/output.css --watch",
    "dev:build": "nuxi build playground",
    "dev:start": "node playground/.output/server/index.mjs",
    "dev:prepare": "PLAYGROUND_MODULE_BUILD=true nuxt-module-build build --stub && PLAYGROUND_MODULE_BUILD=true nuxt-module-build prepare && nuxi prepare playground",
    "release": "npm run lint && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "change-case": "^5.4.4",
    "fzf": "^0.5.2",
    "nuxt-graphql-middleware": "^5.3.2",
    "nuxt-language-negotiation": "^2.0.2",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.2.3",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/kit": "^4.4.2",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.2",
    "@types/node": "latest",
    "@vue/test-utils": "^2.4.6",
    "changelogen": "^0.6.2",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "happy-dom": "^20.8.4",
    "nuxt": "^4.4.2",
    "postcss": "^8.5.8",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "postcss-mixins": "^12.1.2",
    "postcss-nested-import": "^1.3.0",
    "postcss-prefix-selector": "^2.1.1",
    "postcss-replace": "^2.0.1",
    "postcss-url": "^10.1.3",
    "tailwindcss": "^3.4.1",
    "vue-tsc": "^3.2.5"
  }
}
